<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <IsWindowsTarget Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">true</IsWindowsTarget>
        <IsWindowsTarget Condition="'$(IsWindowsTarget)' == ''">false</IsWindowsTarget>
        <TargetFramework Condition="'$(IsWindowsTarget)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
        <TargetFramework Condition="'$(IsWindowsTarget)' != 'true'">net10.0</TargetFramework>
        <EnableWindowsTargeting Condition="'$(IsWindowsTarget)' == 'true'">true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <!-- Function pointers for native callbacks (macOS notification permission block) -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
        <TreatAsLocalProperty>PublishAot;DisableAOT</TreatAsLocalProperty>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets/Branding/app_ico.ico</ApplicationIcon>
        <Version>1.0.98</Version>
        <InformationalVersion>$(Version)</InformationalVersion>
        <!-- Avoid NU1900 when a developer is building offline; CI retains package vulnerability auditing. -->
        <NuGetAudit Condition="'$(CI)' != 'true'">false</NuGetAudit>
        <EffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</EffectiveRuntimeIdentifier>
        <EffectiveRuntimeIdentifier Condition="'$(EffectiveRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</EffectiveRuntimeIdentifier>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    
    <!-- Win7 package (-p:Win7Compat=true, win-x64 only): YY-Thunks stands in for the Windows 8+ APIs the
         AOT runtime imports and VC-LTL links against msvcrt.dll instead of the UCRT. Kept out of the
         regular build so its size and behaviour stay as they are. -->
    <PropertyGroup Condition="'$(Win7Compat)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <ItemGroup Condition="'$(Win7Compat)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
        <PackageReference Include="YY-Thunks" Version="1.2.3" PrivateAssets="all" />
        <PackageReference Include="VC-LTL" Version="5.3.1" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    </PropertyGroup>

    <!-- Debug配置：只禁用AOT以支持设计器预览 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <PublishAot>false</PublishAot>
        <DebuggerSupport>true</DebuggerSupport>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <!-- Release配置：AOT 优化（可通过 -p:DisableAOT=true 关闭） -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(DisableAOT)' != 'true'">
        <!--AOT相关配置-->
        <PublishAot>true</PublishAot>
        <TrimMode>full</TrimMode>
        <UseAppHost>true</UseAppHost>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaEnableILVerify>true</AvaloniaEnableILVerify>
        <AvaloniaSkipUnknownCLRInstrumentation>true</AvaloniaSkipUnknownCLRInstrumentation>
        <!-- <RuntimeIdentifier>osx-x64</RuntimeIdentifier> Removed to allow CLI override -->
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <IlcOptimizationPreference>Size</IlcOptimizationPreference>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <StripSymbols>true</StripSymbols>
        <OptimizationPreference>Size</OptimizationPreference>
        <TieredCompilation>false</TieredCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
        <DebuggerSupport>false</DebuggerSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <StackTraceSupport>false</StackTraceSupport>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <AppleGenerateDSym>false</AppleGenerateDSym>
    </PropertyGroup>
    
    <!-- Fix for Avalonia XAML resource trimming -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="Roots.xml" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <Folder Include="Services\" />
        <!-- Branding\macOS holds the 2048px icns master used only by the packaging scripts. -->
        <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.axaml;Assets\**\.DS_Store;Assets\Binaries\**;Assets\Ed2k\**;Assets\Licenses\**;Assets\cacert.pem;Assets\Branding\macOS\**" />
        <!-- Read-only runtime data goes to resources/ next to the executable (see Helpers/AppPaths.cs);
             the macOS packaging script moves that folder's contents into Contents/Resources. -->
        <Content Include="Assets\cacert.pem">
            <Link>resources\cacert.pem</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\darwin\x64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'osx-x64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\darwin\arm64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'osx-arm64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\linux\x64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'linux-x64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\linux\arm64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'linux-arm64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\win32\x64\aria2c.exe" Condition="'$(EffectiveRuntimeIdentifier)' == 'win-x64'">
            <Link>aria2c.exe</Link>
            <TargetPath>aria2c.exe</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\win32\arm64\aria2c.exe" Condition="'$(EffectiveRuntimeIdentifier)' == 'win-arm64'">
            <Link>aria2c.exe</Link>
            <TargetPath>aria2c.exe</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Ed2k\**" Exclude="Assets\**\.DS_Store">
            <Link>resources\ed2k\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Licenses\**" Exclude="Assets\**\.DS_Store">
            <Link>resources\licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Drawing.Common" Version="10.0.13" Condition="'$(IsWindowsTarget)' == 'true'" />
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
        <PackageReference Include="LiveMarkdown.Avalonia" Version="2.5.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Downio.Generators\Downio.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <!-- An unbundled macOS executable takes its localizations from *.lproj folders next to it.
       Without them, native panels (e.g. the open panel sidebar) fall back to English when running
       from bin/. Packaged builds get these from build/package_osx.sh instead. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="..\..\build\resources\app\*.lproj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
