<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <IsWindowsTarget Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">true</IsWindowsTarget>
        <IsWindowsTarget Condition="'$(IsWindowsTarget)' == ''">false</IsWindowsTarget>
        <TargetFramework Condition="'$(IsWindowsTarget)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
        <TargetFramework Condition="'$(IsWindowsTarget)' != 'true'">net10.0</TargetFramework>
        <EnableWindowsTargeting Condition="'$(IsWindowsTarget)' == 'true'">true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
        <TreatAsLocalProperty>PublishAot;DisableAOT</TreatAsLocalProperty>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets/Branding/app_ico.ico</ApplicationIcon>
        <Version>1.0.85</Version>
        <InformationalVersion>$(Version)</InformationalVersion>
        <!-- Avoid NU1900 when a developer is building offline; CI retains package vulnerability auditing. -->
        <NuGetAudit Condition="'$(CI)' != 'true'">false</NuGetAudit>
        <EffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</EffectiveRuntimeIdentifier>
        <EffectiveRuntimeIdentifier Condition="'$(EffectiveRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</EffectiveRuntimeIdentifier>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    </PropertyGroup>

    <!-- Debug配置：只禁用AOT以支持设计器预览 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <PublishAot>false</PublishAot>
        <DebuggerSupport>true</DebuggerSupport>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <!-- Release配置：AOT 优化（可通过 -p:DisableAOT=true 关闭） -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(DisableAOT)' != 'true'">
        <!--AOT相关配置-->
        <PublishAot>true</PublishAot>
        <TrimMode>full</TrimMode>
        <UseAppHost>true</UseAppHost>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaEnableILVerify>true</AvaloniaEnableILVerify>
        <AvaloniaSkipUnknownCLRInstrumentation>true</AvaloniaSkipUnknownCLRInstrumentation>
        <!-- <RuntimeIdentifier>osx-x64</RuntimeIdentifier> Removed to allow CLI override -->
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <IlcOptimizationPreference>Size</IlcOptimizationPreference>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <StripSymbols>true</StripSymbols>
        <OptimizationPreference>Size</OptimizationPreference>
        <TieredCompilation>false</TieredCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
        <DebuggerSupport>false</DebuggerSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <StackTraceSupport>false</StackTraceSupport>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <AppleGenerateDSym>false</AppleGenerateDSym>
    </PropertyGroup>
    
    <!-- Fix for Avalonia XAML resource trimming -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="Roots.xml" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <Folder Include="Services\" />
        <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.axaml;Assets\Binaries\**;Assets\Ed2k\**;Assets\Licenses\**" />
        <Content Include="Assets\Branding\app_icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\cacert.pem">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\darwin\x64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'osx-x64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\darwin\arm64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'osx-arm64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\linux\x64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'linux-x64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\linux\arm64\aria2c" Condition="'$(EffectiveRuntimeIdentifier)' == 'linux-arm64'">
            <Link>aria2c</Link>
            <TargetPath>aria2c</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\win32\x64\aria2c.exe" Condition="'$(EffectiveRuntimeIdentifier)' == 'win-x64'">
            <Link>aria2c.exe</Link>
            <TargetPath>aria2c.exe</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Binaries\win32\arm64\aria2c.exe" Condition="'$(EffectiveRuntimeIdentifier)' == 'win-arm64'">
            <Link>aria2c.exe</Link>
            <TargetPath>aria2c.exe</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Ed2k\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Licenses\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" Condition="'$(IsWindowsTarget)' == 'true'" />
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
        <PackageReference Include="LiveMarkdown.Avalonia" Version="2.2.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Downio.Generators\Downio.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
