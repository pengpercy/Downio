<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Downio.Models"
        xmlns:conv="using:Downio.Converters"
        xmlns:aconv="using:Avalonia.Data.Converters"
        xmlns:views="using:Downio.Views"
        xmlns:controls="using:Downio.Controls"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="Downio.Views.TaskDetailsWindow"
        x:DataType="models:DownloadTask"
        Classes="dialog"
        Title="{DynamicResource MenuDetails}"
        Width="520" SizeToContent="Height">

    <Window.Resources>
        <conv:StatusToIconConverter x:Key="StatusToIconConverter" />
        <conv:StatusColorConverter x:Key="StatusColorConverter" />
        <conv:ResourceKeyToTextConverter x:Key="ResourceKeyToTextConverter" />
        <conv:Ed2kFileTypeIconConverter x:Key="FileTypeIconConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.detailsCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightBaseLowBrush}" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>

        <Style Selector="Border.metricTile">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.iconButton PathIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Button.iconButton:pointerover PathIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <controls:DialogHost Title="{Binding $parent[Window].Title}">
        <StackPanel Spacing="12">

            <!-- Overview: file identity, status and progress -->
            <Border Classes="detailsCard">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Panel Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top">
                            <Border CornerRadius="12" Opacity="0.12"
                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}" />
                            <PathIcon Data="{Binding Name, Converter={StaticResource FileTypeIconConverter}, ConverterParameter=fileName}"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                        </Panel>

                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <SelectableTextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                 TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Status pill tinted with the status color -->
                                <Panel>
                                    <Border CornerRadius="10" Opacity="0.14"
                                            Background="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,3,10,3">
                                        <PathIcon Data="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                                  Width="10" Height="10"
                                                  Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                        <TextBlock Text="{Binding Status, Converter={StaticResource ResourceKeyToTextConverter}}"
                                                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </StackPanel>
                                </Panel>
                                <TextBlock Text="{Binding SizeInfo}" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource LabelProgress}" />
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:P1}}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Maximum="1.0"
                                     Height="6" MinHeight="6" CornerRadius="3" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Transfer metrics -->
            <Border Classes="detailsCard">
                <StackPanel Spacing="12">
                    <TextBlock Classes="sectionTitle" Text="{DynamicResource LabelTransfer}" />
                    <UniformGrid Columns="4" ColumnSpacing="8">
                        <Border Classes="metricTile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{DynamicResource LabelSpeed}" />
                                <TextBlock Classes="metricValue" Text="{Binding Speed}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Classes="metricTile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{DynamicResource LabelTimeRemaining}" />
                                <Panel>
                                    <TextBlock Classes="metricValue" Text="{Binding TimeLeft}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding TimeLeft, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Classes="metricValue" Text="--" Opacity="0.5"
                                               IsVisible="{Binding TimeLeft, Converter={x:Static aconv:StringConverters.IsNullOrEmpty}}" />
                                </Panel>
                            </StackPanel>
                        </Border>
                        <Border Classes="metricTile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{DynamicResource LabelConnections}" />
                                <TextBlock Classes="metricValue" Text="{Binding Connections}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="metricTile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{DynamicResource LabelSplit}" />
                                <TextBlock Classes="metricValue" Text="{Binding Split}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Link, location and identifier -->
            <Border Classes="detailsCard">
                <StackPanel Spacing="12">
                    <TextBlock Classes="sectionTitle" Text="{DynamicResource LabelTaskInfo}" />

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="76, *, Auto" ColumnSpacing="10"
                              IsVisible="{Binding Url, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource LabelUrl}" Margin="0,7,0,0" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Url}" FontSize="13"
                                                 TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                                 Margin="0,6,0,0" />
                            <Button Grid.Column="2" Classes="iconButton" Click="OnCopyClick" Tag="{Binding Url}"
                                    ToolTip.Tip="{DynamicResource ToolTipCopy}">
                                <PathIcon Data="{StaticResource IconCopy}" />
                            </Button>
                        </Grid>

                        <Border Classes="divider"
                                IsVisible="{Binding Url, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}" />

                        <Grid ColumnDefinitions="76, *, Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource LabelSavePath}" Margin="0,7,0,0" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding FilePath}" FontSize="13"
                                                 TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                <Button Classes="iconButton" Click="OnOpenFolderClick"
                                        ToolTip.Tip="{DynamicResource ToolTipOpenFolder}">
                                    <PathIcon Data="{StaticResource IconFolder}" />
                                </Button>
                                <Button Classes="iconButton" Click="OnCopyClick" Tag="{Binding FilePath}"
                                        ToolTip.Tip="{DynamicResource ToolTipCopy}">
                                    <PathIcon Data="{StaticResource IconCopy}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Classes="divider" />

                        <Grid ColumnDefinitions="76, *, Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource LabelTaskId}" Margin="0,7,0,0" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Id}" FontSize="12"
                                                 FontFamily="Menlo, Consolas, monospace" Opacity="0.85"
                                                 Margin="0,7,0,0" />
                            <Button Grid.Column="2" Classes="iconButton" Click="OnCopyClick" Tag="{Binding Id}"
                                    ToolTip.Tip="{DynamicResource ToolTipCopy}">
                                <PathIcon Data="{StaticResource IconCopy}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                <Button Classes="dialogButton" Click="OnOpenFolderClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                        <TextBlock Text="{DynamicResource ToolTipOpenFolder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{DynamicResource ButtonClose}" Click="OnCloseClick"
                        Classes="dialogButton accent" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </controls:DialogHost>
</views:DialogWindow>
