<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Downio.Views"
        xmlns:controls="using:Downio.Controls"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        mc:Ignorable="d"
        x:Class="Downio.Views.UpdateWindow"
        x:DataType="views:UpdateViewModel"
        Classes="dialog"
        Title="{Binding WindowTitle}">

    <!-- Sized by content: the prompt is a wide sheet with release notes, the progress stages a compact panel -->
    <controls:DialogHost Title="{Binding $parent[Window].Title}">
        <Panel>
            <!-- New version available -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" Width="600" IsVisible="{Binding IsPromptMode}">
                <Image Grid.Column="0" Source="/Assets/Branding/app_icon.png" Width="64" Height="64" VerticalAlignment="Top" />
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="{Binding UpdateTitleText}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Grid.Row="1" Text="{Binding UpdateDescriptionText}" FontSize="13" TextWrapping="Wrap"
                               Opacity="0.85" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource LabelReleaseNotes}" FontSize="13" FontWeight="SemiBold"
                               Margin="0,14,0,6" />
                    <Border Grid.Row="3" Height="280" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <md:MarkdownRenderer MarkdownBuilder="{Binding ReleaseNotesBuilder}" />
                        </ScrollViewer>
                    </Border>
                    <CheckBox Grid.Row="4" IsChecked="{Binding AutoInstallUpdates}" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource LabelAutoUpdate}" FontSize="13" />
                    </CheckBox>
                    <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                        <Button Grid.Column="0" Classes="dialogButton" Content="{DynamicResource ButtonSkipVersion}"
                                Command="{Binding SkipThisVersionCommand}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button Classes="dialogButton" Content="{DynamicResource ButtonRemindLater}"
                                    Command="{Binding RemindMeLaterCommand}" />
                            <Button Classes="dialogButton accent" Content="{DynamicResource ButtonInstallUpdate}"
                                    Command="{Binding InstallUpdateCommand}" IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Checking / downloading / extracting / ready / up to date / failed -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" Width="420" IsVisible="{Binding IsProgressMode}">
                <Image Grid.Column="0" Source="/Assets/Branding/app_icon.png" Width="64" Height="64" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                    <ProgressBar Height="6" MinHeight="6" CornerRadius="3" Minimum="0" Maximum="1"
                                 Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                                 IsVisible="{Binding !ShowDismiss}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                        <TextBlock Grid.Column="0" Text="{Binding DetailText}" FontSize="12.5" Opacity="0.75"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Panel Grid.Column="1" VerticalAlignment="Bottom">
                            <Button Classes="dialogButton" Content="{DynamicResource ButtonCancel}"
                                    Command="{Binding CancelUpdateCommand}"
                                    IsVisible="{Binding ShowCancel}" IsEnabled="{Binding CanCancel}" />
                            <Button Classes="dialogButton accent" Content="{DynamicResource ButtonInstallAndRelaunch}"
                                    Command="{Binding InstallAndRelaunchCommand}"
                                    IsVisible="{Binding ShowInstallAndRelaunch}" IsDefault="{Binding ShowInstallAndRelaunch}" />
                            <Button Classes="dialogButton accent" Content="{DynamicResource ButtonOK}"
                                    Command="{Binding DismissCommand}"
                                    IsVisible="{Binding ShowDismiss}" IsDefault="{Binding ShowDismiss}" />
                        </Panel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Panel>
    </controls:DialogHost>
</views:DialogWindow>
