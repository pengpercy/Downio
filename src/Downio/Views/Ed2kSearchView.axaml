<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Downio.ViewModels"
             xmlns:models="using:Downio.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:localConv="using:Downio.Converters"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="620"
             x:Class="Downio.Views.Ed2kSearchView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <localConv:ResourceKeyToTextConverter x:Key="ResourceKeyToTextConverter" />
        <localConv:Ed2kFileTypeIconConverter x:Key="Ed2kFileTypeIconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Result rows -->
        <Style Selector="Border.resultRow">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.resultRow:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
        </Style>
        <Style Selector="Border.resultRow.checked">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
        </Style>
        <Style Selector="Border.rowTint">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="CornerRadius" Value="4.5" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.resultRow.checked Border.rowTint">
            <Setter Property="Opacity" Value="0.07" />
        </Style>

        <!-- Row checkbox and copy action appear on hover, while selecting, or once checked -->
        <Style Selector="CheckBox.rowCheck">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.resultRow:pointerover CheckBox.rowCheck,
                         ItemsControl.selecting CheckBox.rowCheck,
                         CheckBox.rowCheck:checked">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.rowAction">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.resultRow:pointerover Button.rowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>

        <Style Selector="Button.downloadButton">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.downloadButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
        </Style>

        <!-- Source availability dot: grey (few), amber (some), green (many) -->
        <Style Selector="Ellipse.sourceDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="#9CA3AF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.sourceDot.some">
            <Setter Property="Fill" Value="#F59E0B" />
        </Style>
        <Style Selector="Ellipse.sourceDot.many">
            <Setter Property="Fill" Value="#33D158" />
        </Style>

        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.typeBadge">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Table view -->
        <Style Selector="Border.table">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.tableHeader">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Button.headerCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.headerCell:pointerover, Button.headerCell.sorted">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.headerCell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.headerCell PathIcon.sortMark">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.headerCell.sorted PathIcon.sortMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.headerText">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="Button.headerCell TextBlock.headerText">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.tableRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tableRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>
        <Style Selector="Border.tableRow Border.rowTint">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.tableRow.checked Border.rowTint">
            <Setter Property="Opacity" Value="0.1" />
        </Style>
        <Style Selector="Border.tableRow:pointerover CheckBox.rowCheck,
                         Border.tableRow:pointerover Button.rowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.tableRow Button.rowAction">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.tableRow Button.rowDownload">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.tableRow Button.rowDownload:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Empty states -->
        <Style Selector="StackPanel.emptyState">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Spacing" Value="10" />
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="Margin" Value="0,0,0,40" />
        </Style>
        <Style Selector="StackPanel.emptyState TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Margin="24,16,24,0">

        <!-- Results and empty states -->
        <Panel Grid.Row="0">
            <!-- Table view -->
            <Border Classes="table">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasEd2kResults" />
                        <Binding Path="IsEd2kCompactView" />
                    </MultiBinding>
                </Border.IsVisible>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="tableHeader">
                        <Grid ColumnDefinitions="36,28,*,64,84,76,76,66" Margin="0,0,8,0">
                            <Button Grid.Column="2" Classes="headerCell" HorizontalAlignment="Left" Margin="-4,0,0,0"
                                    Classes.sorted="{Binding Ed2kSortValue, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=name}"
                                    Command="{Binding SortEd2kByCommand}" CommandParameter="name">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Classes="headerText" Text="{DynamicResource Ed2kColumnName}" />
                                    <PathIcon Classes="sortMark" Data="{StaticResource IconChevronDown}" Width="9" Height="9" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="3" Classes="headerText" Text="{DynamicResource Ed2kColumnType}" />
                            <Button Grid.Column="4" Classes="headerCell" HorizontalAlignment="Right"
                                    Classes.sorted="{Binding Ed2kSortValue, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=size}"
                                    Command="{Binding SortEd2kByCommand}" CommandParameter="size">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Classes="headerText" Text="{DynamicResource Ed2kColumnSize}" />
                                    <PathIcon Classes="sortMark" Data="{StaticResource IconChevronDown}" Width="9" Height="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Classes="headerCell" HorizontalAlignment="Right"
                                    Classes.sorted="{Binding Ed2kSortValue, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=sources}"
                                    Command="{Binding SortEd2kByCommand}" CommandParameter="sources">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Classes="headerText" Text="{DynamicResource Ed2kColumnSources}" />
                                    <PathIcon Classes="sortMark" Data="{StaticResource IconChevronDown}" Width="9" Height="9" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="6" Classes="headerText" HorizontalAlignment="Right" Margin="0,0,4,0"
                                       Text="{DynamicResource Ed2kColumnComplete}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Ed2kSearchResults}" Classes.selecting="{Binding HasEd2kSelection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Ed2kSearchResult">
                                    <Border Classes="tableRow" Classes.checked="{Binding IsSelected}"
                                            Tapped="OnResultTapped" DoubleTapped="OnResultDoubleTapped">
                                        <Panel>
                                            <Border Classes="rowTint" />
                                            <Grid ColumnDefinitions="36,28,*,64,84,76,76,66" Margin="0,0,8,0">
                                                <CheckBox Grid.Column="0" Classes="rowCheck" HorizontalAlignment="Center"
                                                          IsChecked="{Binding IsSelected}" IsVisible="{Binding !IsAdded}" />
                                                <PathIcon Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Left"
                                                          Data="{Binding Converter={StaticResource Ed2kFileTypeIconConverter}}"
                                                          Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" Margin="0,0,12,0"
                                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                <Border Grid.Column="3" Classes="typeBadge" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ExtensionBadge}" FontSize="10.5" MaxWidth="52"
                                                               FontWeight="SemiBold" Opacity="0.7" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Classes="cell" HorizontalAlignment="Right"
                                                           Text="{Binding SizeText}" />
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5"
                                                            HorizontalAlignment="Right" Margin="0,0,4,0">
                                                    <Ellipse Classes="sourceDot"
                                                             Classes.some="{Binding HasSomeSources}"
                                                             Classes.many="{Binding HasManySources}" />
                                                    <TextBlock Classes="cell" Text="{Binding SourceCount}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="6" Classes="cell" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                           Text="{Binding CompleteSourceCount}" />
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Classes="rowAction"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyEd2kLinkCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource Ed2kCopyLink}">
                                                        <PathIcon Data="{StaticResource IconLink}" Width="13" Height="13" Opacity="0.7" />
                                                    </Button>
                                                    <Button Classes="rowAction rowDownload" IsVisible="{Binding !IsAdded}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DownloadEd2kResultCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource Ed2kDownloadButton}">
                                                        <PathIcon Data="{StaticResource IconDownloading}" Width="13" Height="13" />
                                                    </Button>
                                                    <Panel Width="26" Height="26" IsVisible="{Binding IsAdded}"
                                                           ToolTip.Tip="{DynamicResource Ed2kAdded}">
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="#33D158" />
                                                    </Panel>
                                                </StackPanel>
                                            </Grid>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Card view -->
            <ScrollViewer>
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasEd2kResults" />
                        <Binding Path="!IsEd2kCompactView" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <ItemsControl ItemsSource="{Binding Ed2kSearchResults}" Classes.selecting="{Binding HasEd2kSelection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Ed2kSearchResult">
                            <Border Classes="resultRow" Classes.checked="{Binding IsSelected}"
                                    Tapped="OnResultTapped" DoubleTapped="OnResultDoubleTapped">
                                <Panel>
                                    <Border Classes="rowTint" />
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="12,10,10,10">
                                        <CheckBox Grid.Column="0" Classes="rowCheck" IsChecked="{Binding IsSelected}"
                                                  IsVisible="{Binding !IsAdded}" />
                                        <Border Grid.Column="0" Width="20" IsVisible="{Binding IsAdded}" />

                                        <Panel Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                                            <Border CornerRadius="7" Opacity="0.12"
                                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}" />
                                            <PathIcon Data="{Binding Converter={StaticResource Ed2kFileTypeIconConverter}}"
                                                      Width="17" Height="17"
                                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                        </Panel>

                                        <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="meta" Text="{Binding SizeText}" />
                                                <TextBlock Classes="meta" Text="·" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse Classes="sourceDot"
                                                             Classes.some="{Binding HasSomeSources}"
                                                             Classes.many="{Binding HasManySources}" />
                                                    <TextBlock Classes="meta">
                                                        <Run Text="{Binding SourceCount}" /><Run Text="{DynamicResource Ed2kSourcesSuffix}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Classes="meta" Text="·" />
                                                <TextBlock Classes="meta">
                                                    <Run Text="{Binding CompleteSourceCount}" /><Run Text="{DynamicResource Ed2kCompleteSuffix}" />
                                                </TextBlock>
                                                <Border Classes="typeBadge">
                                                    <TextBlock Text="{Binding ExtensionBadge}" FontSize="10.5"
                                                               FontWeight="SemiBold" Opacity="0.7" TextWrapping="NoWrap" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="rowAction"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyEd2kLinkCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{DynamicResource Ed2kCopyLink}">
                                                <PathIcon Data="{StaticResource IconLink}" Width="13" Height="13" Opacity="0.7" />
                                            </Button>
                                            <Button Classes="downloadButton" IsVisible="{Binding !IsAdded}"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DownloadEd2kResultCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="{StaticResource IconDownloading}" Width="13" Height="13" />
                                                    <TextBlock Text="{DynamicResource Ed2kDownloadButton}" FontSize="12.5" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="12,0,12,0"
                                                        IsVisible="{Binding IsAdded}">
                                                <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="#33D158" />
                                                <TextBlock Text="{DynamicResource Ed2kAdded}" FontSize="12.5" Foreground="#33D158"
                                                           FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Before the first search -->
            <StackPanel Classes="emptyState" IsVisible="{Binding IsEd2kWelcome}">
                <Panel Width="60" Height="60" HorizontalAlignment="Center">
                    <Border CornerRadius="18" Opacity="0.12"
                            Background="{DynamicResource SystemControlBackgroundAccentBrush}" />
                    <PathIcon Data="{StaticResource IconNetwork}" Width="26" Height="26"
                              Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                </Panel>
                <TextBlock Text="{DynamicResource Ed2kWelcomeTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{DynamicResource Ed2kSearchDescription}" FontSize="13" Opacity="0.65" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Ed2kWelcomeHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Searching, nothing back yet -->
            <StackPanel Classes="emptyState" IsVisible="{Binding IsEd2kWaitingForResults}">
                <ProgressBar IsIndeterminate="True" Width="160" Height="3" MinHeight="3" CornerRadius="2"
                             HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Ed2kSearchStatus}" FontSize="13" Opacity="0.65" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Finished with nothing -->
            <StackPanel Classes="emptyState" IsVisible="{Binding IsEd2kNoResults}">
                <Panel Width="60" Height="60" HorizontalAlignment="Center">
                    <Border CornerRadius="18" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                    <PathIcon Data="{StaticResource IconSearch}" Width="24" Height="24" Opacity="0.5" />
                </Panel>
                <TextBlock Text="{DynamicResource Ed2kNoResultsTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{DynamicResource Ed2kNoResultsHint}" FontSize="13" Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Results exist, but not of the chosen type -->
            <StackPanel Classes="emptyState" IsVisible="{Binding IsEd2kFilteredEmpty}">
                <Panel Width="60" Height="60" HorizontalAlignment="Center">
                    <Border CornerRadius="18" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                    <PathIcon Data="{Binding SelectedEd2kFileType.Value, Converter={StaticResource Ed2kFileTypeIconConverter}}"
                              Width="24" Height="24" Opacity="0.5" />
                </Panel>
                <TextBlock Text="{DynamicResource Ed2kFilteredEmptyTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Button Classes="accent" HorizontalAlignment="Center" Padding="16,7" CornerRadius="8" Margin="0,4,0,0"
                        Command="{Binding StartEd2kSearchCommand}" IsVisible="{Binding !IsEd2kSearching}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" />
                        <TextBlock Text="{DynamicResource Ed2kSearchWithType}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Panel>

        <!-- Status bar: search progress, or the batch actions while rows are checked -->
        <Panel Grid.Row="1" Height="44" IsVisible="{Binding HasEd2kSearched}">
            <TextBlock Text="{Binding Ed2kSearchStatus}" FontSize="12" Opacity="0.6" IsVisible="{Binding !HasEd2kSelection}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEd2kSelection}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Ed2kSelectionText}" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Classes="linkButton" Command="{Binding SelectAllEd2kResultsCommand}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ed2kSelectAll}" FontSize="12" />
                    </Button>
                    <Button Classes="linkButton" Command="{Binding ClearEd2kSelectionCommand}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ed2kClearSelection}" FontSize="12" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Height="28" MinHeight="0" Padding="12,0" CornerRadius="7"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding DownloadSelectedEd2kResultsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconDownloading}" Width="12" Height="12" />
                        <TextBlock Text="{DynamicResource Ed2kDownloadSelected}" FontSize="12.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
