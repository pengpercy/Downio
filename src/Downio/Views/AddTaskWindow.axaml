<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Downio.ViewModels"
        xmlns:views="using:Downio.Views"
        xmlns:controls="using:Downio.Controls"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="460"
        x:Class="Downio.Views.AddTaskWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="dialog"
        Title="{DynamicResource TitleNewTask}"
        Width="520" SizeToContent="Height"
        >

    <views:DialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#4A4A4A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <StreamGeometry x:Key="IconChevronDown">M7.41,8.59L12,13.17l4.59-4.58L18,10l-6,6l-6-6l1.41-1.41z</StreamGeometry>
        </ResourceDictionary>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Styles>
        <!-- Link / torrent switch: a segmented control whose selected segment is a raised card -->
        <Style Selector="ListBox.segmented">
            <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected TextBlock,
                         ListBox.segmented ListBoxItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- Torrent drop zone, sized like the link box so switching modes doesn't move the form -->
        <Style Selector="Border.dropZone">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.dropZone:pointerover">
            <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
        </Style>

        <!-- Option groups, matching the settings window's cards -->
        <Style Selector="Border.formGroup">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.formRow">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Border.formRow:nth-child(1)">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.rowLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="Border.formRow TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- "Advanced options" disclosure -->
        <Style Selector="ToggleButton.disclosure">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="ToggleButton.disclosure:pointerover,
                         ToggleButton.disclosure:checked">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ToggleButton.disclosure PathIcon">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.disclosure:checked PathIcon">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
    </views:DialogWindow.Styles>

    <controls:DialogHost Title="{Binding $parent[Window].Title}">
        <Grid RowDefinitions="Auto, Auto">
            <StackPanel Grid.Row="0" Spacing="12">
                <ListBox Classes="segmented" SelectedIndex="{Binding NewTaskInputModeIndex}">
                    <ListBoxItem Content="{DynamicResource TabLinkTask}" />
                    <ListBoxItem Content="{DynamicResource TabTorrentTask}" />
                </ListBox>

                <Carousel SelectedIndex="{Binding NewTaskInputModeIndex}" Height="112">
                    <Carousel.PageTransition>
                        <CrossFade Duration="0:00:00.150" />
                    </Carousel.PageTransition>

                    <TextBox x:Name="NewTaskUrlTextBox"
                             Text="{Binding NewTaskUrl}"
                             PlaceholderText="{DynamicResource PlaceholderMultiLinks}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"/>

                    <Border Classes="dropZone"
                            Padding="12"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="OnTorrentDragOver"
                            DragDrop.Drop="OnTorrentDrop"
                            PointerPressed="OnTorrentPick">
                        <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconUpload}" Width="24" Height="24" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource TorrentDropHint}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{Binding NewTaskTorrentFileName}" Opacity="0.6" FontSize="12"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       HorizontalAlignment="Center" MaxWidth="400"
                                       IsVisible="{Binding NewTaskTorrentFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </Carousel>

                <Border Classes="formGroup" Margin="0,4,0,0">
                    <StackPanel>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelFileName}"/>
                                <TextBox Grid.Column="1" Text="{Binding NewTaskName}" PlaceholderText="{DynamicResource PlaceholderAutoDetected}"/>
                            </Grid>
                        </Border>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelSavePath}"/>
                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding NewTaskSavePath}" IsReadOnly="True" FontSize="13"
                                             ToolTip.Tip="{Binding NewTaskSavePath}"/>
                                    <Button Grid.Column="1" Command="{Binding ChooseSavePathCommand}" VerticalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Opacity="0.7"/>
                                            <TextBlock Text="{DynamicResource BtnBrowse}" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelChunks}"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding NewTaskChunks}" Minimum="1" Maximum="32" FormatString="0"
                                               Width="132" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <ToggleButton Classes="disclosure" HorizontalAlignment="Left" IsChecked="{Binding NewTaskShowAdvanced}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12"/>
                        <TextBlock Text="{DynamicResource LabelAdvancedOptions}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Border Classes="formGroup" Margin="0,-4,0,0" IsVisible="{Binding NewTaskShowAdvanced}">
                    <StackPanel>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelUserAgent}"/>
                                <TextBox Grid.Column="1" Text="{Binding NewTaskUserAgent}" PlaceholderText="Mozilla/5.0" />
                            </Grid>
                        </Border>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelAuthorization}"/>
                                <TextBox Grid.Column="1" Text="{Binding NewTaskAuthorization}" PlaceholderText="Bearer ..." />
                            </Grid>
                        </Border>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelReferer}"/>
                                <TextBox Grid.Column="1" Text="{Binding NewTaskReferer}" PlaceholderText="https://..." />
                            </Grid>
                        </Border>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelCookie}"/>
                                <TextBox Grid.Column="1" Text="{Binding NewTaskCookie}" PlaceholderText="key=value; ..." />
                            </Grid>
                        </Border>
                        <Border Classes="formRow">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock Classes="rowLabel" Text="{DynamicResource LabelTaskProxy}"/>
                                <TextBox Grid.Column="1" Text="{Binding NewTaskProxy}" PlaceholderText="http://127.0.0.1:7890" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{DynamicResource BtnCancel}" Click="OnCancelClick"
                        Classes="dialogButton" IsCancel="True"/>
                <Button Content="{DynamicResource BtnDownload}" Click="OnDownloadClick"
                        Classes="dialogButton accent" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </controls:DialogHost>
</views:DialogWindow>
