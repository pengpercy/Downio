<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Downio.ViewModels"
             xmlns:models="using:Downio.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:localConv="using:Downio.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Downio.Views.TaskListView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <localConv:ResourceKeyToTextConverter x:Key="ResourceKeyToTextConverter" />
        <localConv:StatusColorConverter x:Key="StatusColorConverter" />
        <localConv:StatusToIconConverter x:Key="StatusToIconConverter" />
        <localConv:CollectionIsEmptyConverter x:Key="CollectionIsEmptyConverter" />
        <localConv:Ed2kFileTypeIconConverter x:Key="FileTypeIconConverter" />
        <localConv:SystemFileIconConverter x:Key="SystemFileIconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Task card: hairline border and a soft shadow that lifts on hover -->
        <Style Selector="Border.taskCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.taskCard">
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardHoverShadow}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.taskCard">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
        </Style>

        <!-- Selected cards get an accent wash behind the content plus a check badge on the file tile -->
        <Style Selector="Border.selectionTint">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
            <Setter Property="CornerRadius" Value="4.5" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:selected Border.selectionTint">
            <Setter Property="Opacity" Value="0.08" />
        </Style>
        <Style Selector="Border.selectionCheck">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.selectionCheck">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Secondary actions stay out of the way until the card is hovered or selected -->
        <Style Selector="StackPanel.secondaryActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.secondaryActions, ListBoxItem:selected StackPanel.secondaryActions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="Button.taskAction">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.taskAction PathIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Button.taskAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.taskAction:pointerover PathIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.taskAction.danger:pointerover PathIcon">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>

        <!-- Primary pause/resume control -->
        <Style Selector="Button.taskToggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.taskToggle PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="Button.taskToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
        </Style>
        <Style Selector="Button.taskToggle:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
        </Style>

        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Override default ListBoxItem selection styles to avoid blue background -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ListBox x:Name="TasksListBox"
                  ItemsSource="{Binding Tasks}"
                  Margin="20,8,20,16"
                  Background="Transparent"
                   SelectionMode="Multiple"
                   KeyDown="OnKeyDown"
                  SelectionChanged="OnSelectionChanged"
                  IsVisible="{Binding Tasks.Count, Converter={StaticResource CollectionIsEmptyConverter}, ConverterParameter=not}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:DownloadTask">
                    <Border Classes="taskCard">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource MenuDetails}"
                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTaskDetailsCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconInfo}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource ToolTipOpenFolder}" Click="OpenFolderButton_Click">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource ToolTipCopyLink}"
                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyLinkCommand}"
                                          CommandParameter="{Binding}"
                                          IsVisible="{Binding Url, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource MenuDelete}"
                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTaskCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Panel>
                        <Border Classes="selectionTint" />
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Margin="14,12">
                            <!-- File type tile: neutral glyph, or the file manager's own icon for unrecognised types -->
                            <Panel Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                <Border CornerRadius="7" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        IsVisible="{Binding !#SystemIcon.IsVisible}" />
                                <PathIcon Data="{Binding Name, Converter={StaticResource FileTypeIconConverter}, ConverterParameter=fileName}"
                                          Width="18" Height="18" Opacity="0.7"
                                          IsVisible="{Binding !#SystemIcon.IsVisible}"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <Image x:Name="SystemIcon" Width="36" Height="36"
                                       Source="{Binding Name, Converter={StaticResource SystemFileIconConverter}}"
                                       IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <Border Classes="selectionCheck" Width="18" Height="18" CornerRadius="9"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"
                                        BorderThickness="2" BorderBrush="{DynamicResource CardBackgroundBrush}"
                                        Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="9" Height="9"
                                              Foreground="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
                                </Border>
                            </Panel>

                            <!-- Name, progress and meta line -->
                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}" />

                                <ProgressBar Value="{Binding Progress}" Maximum="1.0"
                                             Height="4" MinHeight="4" CornerRadius="2"
                                             IsVisible="{Binding !IsCompleted}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                        <TextBlock Text="{Binding Status, Converter={StaticResource ResourceKeyToTextConverter}}"
                                                   FontSize="12" FontWeight="Medium" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </StackPanel>

                                    <TextBlock Classes="meta" Text="·" />
                                    <TextBlock Classes="meta" Text="{Binding SizeInfo}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsActive}">
                                        <TextBlock Classes="meta" Text="·" />
                                        <TextBlock Classes="meta" Text="{Binding Progress, StringFormat={}{0:P0}}" />
                                        <TextBlock Classes="meta" Text="·" />
                                        <TextBlock Classes="meta" Text="{Binding Speed, StringFormat={}↓ {0}}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding TimeLeft, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Classes="meta" Text="·" />
                                            <TextBlock Classes="meta">
                                                <Run Text="{DynamicResource LabelTimeRemaining}" />
                                                <Run Text="{Binding TimeLeft}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Classes="meta" Text="·" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.6"
                                                    ToolTip.Tip="{DynamicResource LabelSplit}">
                                            <PathIcon Data="{StaticResource IconNetwork}" Width="12" Height="12"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Split}" FontSize="12" TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Classes="secondaryActions" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Button Classes="taskAction" Click="OpenFolderButton_Click"
                                            ToolTip.Tip="{DynamicResource ToolTipOpenFolder}">
                                        <PathIcon Data="{StaticResource IconFolder}" />
                                    </Button>
                                    <Button Classes="taskAction"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyLinkCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{DynamicResource ToolTipCopyLink}"
                                            IsVisible="{Binding Url, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <PathIcon Data="{StaticResource IconLink}" />
                                    </Button>
                                    <Button Classes="taskAction"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ShowTaskDetailsCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{DynamicResource MenuDetails}">
                                        <PathIcon Data="{StaticResource IconInfo}" />
                                    </Button>
                                    <Button Classes="taskAction danger"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteTaskCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{DynamicResource MenuDelete}">
                                        <PathIcon Data="{StaticResource IconTrash}" />
                                    </Button>
                                </StackPanel>

                                <Button Classes="taskToggle"
                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleTaskStateCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding CanToggleState}">
                                    <PathIcon Data="{Binding Status, Converter={StaticResource StatusToIconConverter}}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border IsHitTestVisible="True"
                Margin="20,10,20,20"
                Background="Transparent"
                IsVisible="{Binding Tasks.Count, Converter={StaticResource CollectionIsEmptyConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="420">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                        Padding="28"
                        BoxShadow="{DynamicResource CardShadow}">
                    <StackPanel Spacing="14">
                        <Border Width="56" Height="56" CornerRadius="28"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconAdd}" Width="18" Height="18"
                                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      Opacity="0.75"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{DynamicResource EmptyStateTitleNoTasks}"
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding EmptyStateSubtitleDownloadingText}"
                                   FontSize="13" Opacity="0.7"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsDownloading}" />
                        <TextBlock Text="{DynamicResource EmptyStateSubtitleWaiting}"
                                   FontSize="13" Opacity="0.7"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsWaiting}" />
                        <TextBlock Text="{DynamicResource EmptyStateSubtitleStopped}"
                                   FontSize="13" Opacity="0.7"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsStopped}" />

                        <Button Content="{DynamicResource BtnNewTask}"
                                Command="{Binding ShowAddTaskCommand}"
                                Classes="accent"
                                CornerRadius="5"
                                HorizontalAlignment="Center"
                                Padding="16,8"
                                Margin="0,4,0,0"
                                />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
