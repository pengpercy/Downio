            <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-0.82,2.33-3.04,4-5.65,4c-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14,0.69,4.22,1.78L13,11h7V4L17.65,6.35z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M9.5,3a6.5,6.5,0,1,0,3.98,11.64L19.85,21L21,19.85l-6.36-6.37A6.5,6.5,0,0,0,9.5,3z M9.5,5a4.5,4.5,0,1,1,0,9a4.5,4.5,0,0,1,0-9z</StreamGeometry>
            <StreamGeometry x:Key="IconFileGeneric">M6,2h8l4,4v16H6V2z M13,3.5V7h3.5L13,3.5z</StreamGeometry>
            <StreamGeometry x:Key="IconFileAudio">M15,3v11.3A3.5,3.5,0,1,1,13,11V6l-6,1.5v8.8A3.5,3.5,0,1,1,5,13V5l10-2z</StreamGeometry>
            <StreamGeometry x:Key="IconFileVideo">M4,4h16v16H4V4z M6,6v3h3V6H6z M11,6v8l5-4l-5-4z M17,6v3h1V6h-1z M6,15v3h3v-3H6z M17,15v3h1v-3h-1z</StreamGeometry>
            <StreamGeometry x:Key="IconFileDocument">M6,2h8l4,4v16H6V2z M13,3.5V7h3.5L13,3.5z M8,11h8v1.5H8V11z M8,14h8v1.5H8V14z M8,17h6v1.5H8V17z</StreamGeometry>
