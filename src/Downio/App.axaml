            <StreamGeometry x:Key="IconAppearance">M12,3C7.03,3,3,7.03,3,12c0,4.97,4.03,9,9,9c0.55,0,1-0.45,1-1c0-0.24-0.09-0.47-0.24-0.65c-0.16-0.19-0.26-0.43-0.26-0.7c0-0.55,0.45-1,1-1h1.5c2.49,0,4.5-2.01,4.5-4.5C20,7.58,16.42,3,12,3z M6.5,12c-0.83,0-1.5-0.67-1.5-1.5S5.67,9,6.5,9S8,9.67,8,10.5S7.33,12,6.5,12z M9.5,8c-0.83,0-1.5-0.67-1.5-1.5S8.67,5,9.5,5S11,5.67,11,6.5S10.33,8,9.5,8z M14.5,8c-0.83,0-1.5-0.67-1.5-1.5S13.67,5,14.5,5S16,5.67,16,6.5S15.33,8,14.5,8z M17.5,12c-0.83,0-1.5-0.67-1.5-1.5S16.67,9,17.5,9S19,9.67,19,10.5S18.33,12,17.5,12z</StreamGeometry>
