    </Application.Resources>

    <Application.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        </Style>

        <!-- Menus (context menus and the Windows tray menu, which is drawn as a MenuFlyoutPresenter):
             rounded neutral highlight, inset from the popup edge -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="4,1" />
        </Style>
        <!-- Dropdown items: rounded highlight, inset from the popup edge -->
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="4,1" />
        </Style>
    </Application.Styles>
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Branding/app_ico.ico" ToolTipText="Downio" Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <!-- Live total, refreshed with the task list -->
                        <NativeMenuItem Header="{Binding TotalDownloadSpeedText, StringFormat='↓ {0}'}" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{DynamicResource MenuOpenDownio}" Command="{Binding ToggleMainWindowCommand}" />
                        <NativeMenuItem Header="{DynamicResource MenuNewTask}" Gesture="{x:Static helpers:MenuGestures.NewTask}"
                                        Command="{Binding ShowAddTaskCommand}" />
                        <NativeMenuItem Header="{DynamicResource MenuOpenDownloadFolder}" Gesture="{x:Static helpers:MenuGestures.OpenDownloadFolder}"
                                        Command="{Binding OpenDownloadFolderCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{DynamicResource MenuResumeAll}" Gesture="{x:Static helpers:MenuGestures.ResumeAll}"
                                        Command="{Binding ResumeAllCommand}" />
                        <NativeMenuItem Header="{DynamicResource MenuPauseAll}" Gesture="{x:Static helpers:MenuGestures.PauseAll}"
                                        Command="{Binding PauseAllCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{DynamicResource MenuSettingsEllipsis}" Gesture="{x:Static helpers:MenuGestures.Settings}"
                                        Command="{Binding ShowSettingsCommand}" />
                        <NativeMenuItem Header="{DynamicResource MenuCheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{DynamicResource MenuQuitApp}" Gesture="{x:Static helpers:MenuGestures.Quit}"
                                        Command="{Binding QuitAppCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
