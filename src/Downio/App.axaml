            <StreamGeometry x:Key="IconPlay">M8,5v14l11-7L8,5z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M6,19h4V5H6V19z M14,5v14h4V5H14z</StreamGeometry>
