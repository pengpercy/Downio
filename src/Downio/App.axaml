<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Downio.App"
             Name="Downio"
             xmlns:local="using:Downio"
             xmlns:controls="using:Downio.Controls"
             xmlns:helpers="using:Downio.Helpers"
             xmlns:vm="using:Downio.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />

        <Style Selector="Window.dialog">
            <Setter Property="WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="CanResize" Value="False" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="WindowDecorations" Value="Full" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="44" />
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="Button#PART_MinimizeButton,
                         Button#PART_MaximizeButton,
                         Button#PART_CloseButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        
        <Style Selector="Button#PART_CloseButton">
            <Setter Property="Width" Value="47" />
            <Setter Property="MinWidth" Value="47" />
        </Style>

        <!-- Every window draws its own title (DialogHost, the settings sidebar), so drop the
             decorations' left-aligned copy instead of showing the title twice -->
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Button#PART_PopoverFullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Border.dialogRoot">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
        </Style>

        <Style Selector="controls|DialogHost">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="dialogRoot">
                        <Grid RowDefinitions="44, *">
                            <Border Grid.Row="0"
                                    Background="{DynamicResource WorkspaceBackgroundBrush}">
                                <TextBlock Text="{TemplateBinding Title}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="24,16,24,24"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.dialogButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}"/>
        </Style>

        <Style Selector="Button.linkButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.linkButton:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.linkButton TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        </Style>

        <!-- Keep editable fields visually connected to cards. Fluent paints the
             focused fill on an internal template border, so the matching theme
             resources below are overridden as well as the control background. -->
        <Style Selector="TextBox, NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        </Style>
        <Style Selector="TextBox:focus, NumericUpDown:focus-within">
            <Setter Property="Background" Value="{DynamicResource InputFocusedBackgroundBrush}" />
        </Style>
        
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{DynamicResource LabelSwitchOn}" />
            <Setter Property="OffContent" Value="{DynamicResource LabelSwitchOff}" />
        </Style>
    </Application.Styles>

    <!-- macOS application menu. Avalonia's own Hide / Hide Others / Show All / Quit items are
         English-only, so they are disabled in Program.cs and provided here with localized headers. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{DynamicResource MenuAbout}" Command="{Binding ShowAboutCommand}" />
            <NativeMenuItem Header="{DynamicResource MenuCheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{DynamicResource MenuSettingsEllipsis}" Gesture="{x:Static helpers:MenuGestures.Settings}"
                            Command="{Binding ShowSettingsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{DynamicResource MenuHideApp}" Gesture="{x:Static helpers:MenuGestures.Hide}"
                            Command="{Binding HideAppCommand}" />
            <NativeMenuItem Header="{DynamicResource MenuHideOthers}" Gesture="{x:Static helpers:MenuGestures.HideOthers}"
                            Command="{Binding HideOtherAppsCommand}" />
            <NativeMenuItem Header="{DynamicResource MenuShowAll}" Command="{Binding ShowAllAppsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{DynamicResource MenuQuitApp}" Gesture="{x:Static helpers:MenuGestures.Quit}"
                            Command="{Binding QuitAppCommand}" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CFECECEF" />
                    <SolidColorBrush x:Key="SidebarMicaTintBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SidebarItemHoverBackgroundBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="SidebarItemSelectedBackgroundBrush" Color="#1C000000" />
                    <SolidColorBrush x:Key="SidebarTextForegroundBrush" Color="#1F1F1F" />
                    <Color x:Key="SidebarAcrylicTintColor">#ECECEF</Color>
                    <x:Double x:Key="SidebarAcrylicTintOpacity">0.4</x:Double>
                    <x:Double x:Key="SidebarAcrylicMaterialOpacity">0.2</x:Double>
                    <BoxShadows x:Key="CardShadow">0 1 3 0 #0D000000</BoxShadows>
                    <BoxShadows x:Key="CardHoverShadow">0 4 14 0 #14000000</BoxShadows>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E6EA" />
                    <!-- Window dividers (sidebar edge, toolbar bottom): BaseLow at 55% -->
                    <SolidColorBrush x:Key="DividerBrush" Color="#1C000000" />
                    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#D2D5DB" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#FFF7F8FA" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFAFBFC" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFF7F8FA" />
                    <!-- Dropdowns: same surface as text inputs, neutral hover for items -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFAFBFC" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFF3F4F6" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFDDE0E5" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFCDD1D7" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFC3C7CE" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFE4E6EA" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#0F000000" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#17000000" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#0F000000" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#17000000" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#1F000000" />
                    <!-- Menus and the tray menu: neutral hover instead of the accent color -->
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0F000000" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#17000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#242424" />
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#343434" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseLowBrush" Color="#000000" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#C01F2022" />
                    <SolidColorBrush x:Key="SidebarMicaTintBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="SidebarItemHoverBackgroundBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="SidebarItemSelectedBackgroundBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="SidebarTextForegroundBrush" Color="#F4F4F4" />
                    <Color x:Key="SidebarAcrylicTintColor">#1F2022</Color>
                    <x:Double x:Key="SidebarAcrylicTintOpacity">0.4</x:Double>
                    <x:Double x:Key="SidebarAcrylicMaterialOpacity">0.2</x:Double>
                    <BoxShadows x:Key="CardShadow">0 1 3 0 #33000000</BoxShadows>
                    <BoxShadows x:Key="CardHoverShadow">0 4 14 0 #59000000</BoxShadows>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />
                    <!-- Window dividers (sidebar edge, toolbar bottom): BaseLow at 55% -->
                    <SolidColorBrush x:Key="DividerBrush" Color="#8C000000" />
                    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF3E3E3E" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF1F1F1F" />
                    <!-- Dropdowns: same surface as text inputs, neutral hover for items -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF404040" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF363636" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF333333" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#26FFFFFF" />
                    <!-- Menus and the tray menu: neutral hover instead of the accent color -->
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1FFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Inset the dropdown list so the rounded item highlights don't touch the popup edge -->
            <Thickness x:Key="ComboBoxDropdownBorderPadding">0,4</Thickness>

            <!-- One corner radius for the whole app, matching the sidebar item highlight. Overriding
                 Fluent's own keys also rounds inputs, buttons, dropdowns, flyouts and tooltips. -->
            <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">5</CornerRadius>
            <!-- Fills drawn inside a card's 1.5px border -->
            <CornerRadius x:Key="CardInnerCornerRadius">3.5</CornerRadius>

            <!-- Icons -->
            <StreamGeometry x:Key="IconAdd">M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z</StreamGeometry>
            <StreamGeometry x:Key="IconDownloading">M11,4h2v8.17l3.59-3.58L18,10l-6,6l-6-6l1.41-1.41L11,12.17V4z M4,20v-2h16v2H4z</StreamGeometry>
            <StreamGeometry x:Key="IconWaiting">M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,6c0.55,0,1,0.45,1,1v5l4.25,2.52c0.48,0.28,0.63,0.89,0.35,1.37c-0.28,0.48-0.89,0.63-1.37,0.35L11,12.75V7C11,6.45,11.45,6,12,6z</StreamGeometry>
            <StreamGeometry x:Key="IconStopped">M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M9,16c-0.55,0-1-0.45-1-1V9c0-0.55,0.45-1,1-1h6c0.55,0,1,0.45,1,1v6c0,0.55-0.45,1-1,1H9z</StreamGeometry>
