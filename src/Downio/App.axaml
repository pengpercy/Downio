            <StreamGeometry x:Key="IconAdvanced">M12,2l1.2,3.6l3.8,0.1l-3,2.2l1.1,3.7L12,9.9L8.9,11.6L10,7.9l-3-2.2l3.8-0.1L12,2z M19,13v2h-2v-2h2z M7,13v2H5v-2h2z M13,17v2h-2v-2h2z</StreamGeometry>
            <StreamGeometry x:Key="IconMenu">M3,18h18v-2H3V18z M3,13h18v-2H3V13z M3,6v2h18V6H3z</StreamGeometry>
